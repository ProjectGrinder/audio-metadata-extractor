[configuration]

entry_symbol = "initialize_library"
compatibility_minimum = "4.1"

[libraries]

windows.debug.x86_64 = "res://addons/audio_metadata_extension/bin/audio_metadata_extension-godot.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/audio_metadata_extension/bin/audio_metadata_extension-godot.windows.x86_64.dll"

linux.debug.x86_64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension-godot.linux.x86_64.so"
linux.release.x86_64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension-godot.linux.x86_64.so"

linux.debug.arm64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension-godot.linux.arm64.so"
linux.release.arm64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension-godot.linux.arm64.so"

macos.debug = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension-godot.macos.dylib"
macos.release = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension-godot.macos.dylib"
