{
  "version": 3,
  "configurePresets": [
    {
      "name": "win64",
      "displayName": "Windows x86_64 (clang-cl)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux64",
      "displayName": "Linux x86_64 (Native GCC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux ARM64 (GNU Cross-Compiler)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-arm64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS Universal (Apple Clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win64",
      "configurePreset": "win64"
    },
    {
      "name": "linux64",
      "configurePreset": "linux64"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64"
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal"
    }
  ]
}
