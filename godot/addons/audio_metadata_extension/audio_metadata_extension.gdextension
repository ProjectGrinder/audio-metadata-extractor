[configuration]

entry_symbol = "audio_metadata_extension_entry"
compatibility_minimum = "4.1"

[libraries]

windows.debug.x86_64 = "res://addons/audio_metadata_extension/bin/audio_metadata_extension.windows.dll"
windows.release.x86_64 = "res://addons/audio_metadata_extension/bin/audio_metadata_extension.windows.dll"

linux.debug.x86_64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension.linux.x86_64.so"
linux.release.x86_64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension.linux.x86_64.so"

linux.debug.arm64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension.linux.arm64.so"
linux.release.arm64 = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension.linux.arm64.so"

macos.debug = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension.macos.dylib"
macos.release = "res://addons/audio_metadata_extension/bin/libaudio_metadata_extension.macos.dylib"
